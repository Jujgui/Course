## Recuperation du tableur
def loca(adr):
    # fonction qui retourne une liste avec en premier terme la latitude et en second, la longitude, d'une adresse en entrée  
    api_url = "https://api-adresse.data.gouv.fr/search/?q="
    r = requests.get(api_url + urllib.parse.quote(adr))
    comments = json.loads(r.text)
    return [comments['features'][0]['geometry']['coordinates'][1],
            comments['features'][0]['geometry']['coordinates'][0]]

