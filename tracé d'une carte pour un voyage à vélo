def limite_zone(VilleOuest,VilleEst,VilleSud,VilleNord):
    # permet de récupérer un cadre à patir d'adresse

gdf = gpd.read_file('https://www.data.gouv.fr/fr/datasets/r/f5ca8714-f61c-43bf-a1ca-62ed108b820e')

min_x, max_x, min_y, max_y = limite_zone('La Baule-Escoublac','La Possonière','La Roche-sur-Yon','Dominelais')

gdf_clipped = gdf.cx[min_x:max_x, min_y:max_y]
    # VilleOuest est la ville la plus à l'Ouest du rectangle que nous formons avec les 4 villes
    return loca(VilleOuest)[1],loca(VilleEst)[1],loca(VilleSud)[0],loca(VilleNord)[0]

