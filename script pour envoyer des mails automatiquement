def assignation_mission(Prénom):
    cible = Cible[rd.randint(0,len(Cible)-1)]
    ordre = Mission[rd.randint(0,len(Mission)-1)]
    Mission.remove(ordre)
    Cible.remove(cible)
    if Prénom == cible:
        return assignation_mission(Prénom)
    return ordre + cible

